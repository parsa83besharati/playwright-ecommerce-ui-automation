{
  "name": "playwright-ecommerce-ui-automation",
  "version": "1.0.0",
  "description": "Production-grade Playwright TypeScript UI automation framework for e-commerce testing (LambdaTest OpenCart Playground).",
  "scripts": {
    "test": "npx playwright test",
    "test:smoke": "npx playwright test tests/ui/smoke.spec.ts",
    "test:regression": "npx playwright test tests/ui/regression.spec.ts",
    "test:negative": "npx playwright test tests/ui/negative.spec.ts",
    "test:edge": "npx playwright test tests/ui/edge.spec.ts",
    "test:security": "npx playwright test tests/ui/security.spec.ts",
    "test:chromium": "npx playwright test --project=chromium",
    "test:firefox": "npx playwright test --project=firefox",
    "test:webkit": "npx playwright test --project=webkit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:check": "eslint . --max-warnings 0",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,json,md}": [
      "prettier --write"
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/parsa83besharati/playwright-ecommerce-ui-automation.git"
  },
  "keywords": ["playwright", "typescript", "e-commerce", "automation", "testing", "qa"],
  "author": "Parsa Besharati",
  "license": "MIT",
  "type": "commonjs",
  "devDependencies": {
    "@cucumber/cucumber": "^12.8.3",
    "@playwright/test": "^1.59.1",
    "@types/dateformat": "^5.0.3",
    "@types/node": "^25.8.0",
    "@types/uuid": "^10.0.0",
    "@types/winston": "^2.4.4",
    "@typescript-eslint/eslint-plugin": "^8.59.3",
    "@typescript-eslint/parser": "^8.59.3",
    "dateformat": "^5.0.3",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-playwright": "^2.10.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.4",
    "prettier": "^3.8.3",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@faker-js/faker": "^10.4.0",
    "dotenv": "^17.4.2",
    "openai": "^6.38.0",
    "playwright-enhanced-reporter": "^3.0.1",
    "uuid": "^14.0.0",
    "winston": "^3.19.0"
  }
}
