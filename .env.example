# ==================== APPLICATION UNDER TEST ====================
# Base URL for the e-commerce store (all navigation resolves via config/env.ts)
BASE_URL=https://ecommerce-playground.lambdatest.io

# Browser: set false to run headed locally
HEADLESS=false

# ==================== SELF-HEALING (AI) ====================
# Enable AI-powered selector healing when locators break
SELF_HEALING_ENABLED=false

# Healing mode: 'runtime' (heal during test) or 'post-mortem' (analyze failures)
HEALING_MODE=runtime

# ==================== LLM PROVIDERS (configure at least one) ====================
# Providers are tried in priority order: DeepSeek > OpenAI > Anthropic > Custom

# --- DeepSeek (recommended: cheapest & fast) ---
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# --- OpenAI (reliable fallback) ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# --- Anthropic (optional) ---
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
ANTHROPIC_MODEL=claude-3-haiku-20240307

# --- Custom / Local LLM (e.g., Ollama, LM Studio, vLLM) ---
CUSTOM_LLM_API_KEY=sk-local
CUSTOM_LLM_BASE_URL=http://localhost:11434/v1
CUSTOM_LLM_MODEL=llama3
